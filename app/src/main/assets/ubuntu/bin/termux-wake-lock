#!/bin/bash
set -e -u

SCRIPTNAME=termux-wake-lock
show_usage () {
    echo "Usage: $SCRIPTNAME"
    echo "Acquires the wakelock of UbuntuTerm, so that the device is not suspended"
    echo "while a long task of the guest is running."
    exit 0
}

while getopts :h option
do
    case "$option" in
        h) show_usage;;
        ?) echo "$SCRIPTNAME: illegal option -$OPTARG"; exit 1;
    esac
done
shift $((OPTIND-1))

if [ $# != 0 ]; then echo "$SCRIPTNAME: too many arguments"; exit 1; fi

/usr/local/lib/ubutumerm/termux-api WakeLock
