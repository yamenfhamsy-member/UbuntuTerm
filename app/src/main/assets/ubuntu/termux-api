#!/bin/sh
#
# UbuntuTerm Android API client (dispatcher).
#
# Executes the Perl implementation of the Termux:API client, or the Python implementation
# when Perl is not available. Both implementations speak the same protocol, see
# termux-api.pl for the details.

set -u

LIB_DIR="/usr/local/lib/ubuntuterm"

for interpreter in /usr/bin/perl /usr/bin/python3; do
    if [ -x "$interpreter" ]; then
        if [ "$interpreter" = "/usr/bin/perl" ] && [ -f "$LIB_DIR/termux-api.pl" ]; then
            exec "$interpreter" "$LIB_DIR/termux-api.pl" "$@"
        fi
        if [ "$interpreter" = "/usr/bin/python3" ] && [ -f "$LIB_DIR/termux-api.py" ]; then
            exec "$interpreter" "$LIB_DIR/termux-api.py" "$@"
        fi
    fi
done

echo "termux-api: neither perl nor python3 is available in the guest." >&2
echo "termux-api: install one of them with 'apt-get install perl' or 'apt-get install python3'." >&2
exit 1
