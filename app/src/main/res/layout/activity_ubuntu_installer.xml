<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/ubuntu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ubuntu_installer_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ubuntu_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ubuntu_installer_subtitle"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ubuntu_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ubuntu_installer_status_idle"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/ubuntu_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100" />

    <TextView
        android:id="@+id/ubuntu_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="13sp" />

    <Button
        android:id="@+id/ubuntu_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ubuntu_installer_retry" />

    <Button
        android:id="@+id/ubuntu_host_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ubuntu_installer_host_mode" />

</LinearLayout>
